{
	"name": "rotemyagel/wm-posts-grid-filter",
	"description": "Dev-only tooling: WordPress Coding Standards (phpcs.xml.dist) and PHPUnit (phpunit.xml.dist). Not a runtime dependency.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-phpunit/wp-phpunit": "^7.1 || ^6.8"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint:php": "phpcs",
		"lint:php-fix": "phpcbf"
	}
}
