{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wmpgf/posts-grid",
  "title": "Posts Grid",
  "category": "wmpgf",
  "icon": "grid-view",
  "description": "Displays Grid Posts in a configurable grid. Sync with a Posts Filter block placed anywhere on the page.",
  "keywords": [
    "posts",
    "grid",
    "query"
  ],
  "textdomain": "wm-posts-grid-filter",
  "attributes": {
    "columns": {
      "type": "number",
      "default": 3
    },
    "postsPerPage": {
      "type": "number",
      "default": 6
    },
    "fallbackImageId": {
      "type": "number",
      "default": 0
    }
  },
  "providesContext": {
    "wmpgf/postsPerPage": "postsPerPage"
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "example": {
    "attributes": {
      "columns": 3,
      "postsPerPage": 3
    }
  },
  "editorScript": "file:./index.js",
  "viewScriptModule": "file:./view.js",
  "style": [
    "wmpgf-tokens",
    "file:./style-index.css"
  ],
  "render": "file:./render.php"
}