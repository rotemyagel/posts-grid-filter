<?xml version="1.0"?>
<ruleset name="wm-posts-grid-filter">
	<description>WordPress Coding Standards for this plugin.</description>

	<!-- Scan the plugin's own PHP; skip vendored/generated code. -->
	<file>.</file>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<!-- Matches the plugin header's declared minimum. -->
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wm-posts-grid-filter"/>
			</property>
		</properties>
	</rule>

	<!--
		templates/single-pgf_post.php is named exactly the way WordPress's
		own template-hierarchy convention requires: single-{$post_type}.php,
		where the post type itself is pgf_post (underscore, matching how
		register_post_type() names it), checked directly against
		PGF_Single_Template's locate_template() call, which looks for this
		exact filename so a theme can override it the same way core's own
		template hierarchy expects. Renaming the file to satisfy this sniff's
		generic hyphens only preference would silently break that override
		mechanism for any theme that follows the same core convention.
	-->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>templates/single-pgf_post\.php</exclude-pattern>
	</rule>
</ruleset>
