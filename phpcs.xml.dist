<?xml version="1.0"?>
<ruleset name="wm-posts-grid-filter">
	<description>WordPress Coding Standards for this plugin.</description>

	<!-- Scan the plugin's own PHP; skip vendored/generated code. -->
	<file>.</file>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<!-- Matches the plugin header's declared minimum. -->
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wm-posts-grid-filter"/>
			</property>
		</properties>
	</rule>

	<!-- Every global (function, class, constant, hook, variable) must carry the plugin prefix. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="wmpgf"/>
			</property>
		</properties>
	</rule>

	<!--
		These files are included inside a WordPress function (WP_Block::render(),
		load_template(), uninstall_plugin()), so their variables are local, not
		globals. Functions, classes, constants and hooks are still checked.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedVariableFound">
		<exclude-pattern>src/blocks/*/render\.php</exclude-pattern>
		<exclude-pattern>templates/*</exclude-pattern>
		<exclude-pattern>uninstall\.php</exclude-pattern>
	</rule>

	<!-- WordPress's template hierarchy requires single-{post_type}.php, underscore included. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>templates/single-wmpgf_post\.php</exclude-pattern>
	</rule>

	<!--
		Tests follow PHPUnit's conventions, as core's own tests do: files are
		found by their test- prefix, classes are named Test_*, and a test's
		name says what it checks, so it needs no doc comment.
	-->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>tests/php/test-*\.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedClassFound">
		<exclude-pattern>tests/php/test-*\.php</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>tests/php/*</exclude-pattern>
	</rule>
</ruleset>
