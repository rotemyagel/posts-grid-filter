# Text files are stored and checked out with LF on every system, whatever
# core.autocrlf says, so PHPCS, the build check and the release zip see the
# same bytes on Windows as in CI.
* text=auto eol=lf

# Binary files are never converted.
*.woff2 binary
*.woff binary
*.ttf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
