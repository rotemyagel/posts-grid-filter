{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wmpgf/posts-filter",
	"title": "Posts Filter",
	"category": "wmpgf",
	"icon": "filter",
	"description": "Category and tag checkboxes that filter the Posts Grid block. Can be placed anywhere on the page, not just next to the grid.",
	"keywords": [ "filter", "category", "tag" ],
	"textdomain": "wm-posts-grid-filter",
	"attributes": {
		"heading": { "type": "string", "default": "" },
		"showSearch": { "type": "boolean", "default": true }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"example": {},
	"editorScript": "file:./index.js",
	"viewScriptModule": "file:./view.js",
	"style": [ "wmpgf-tokens", "file:./style-index.css" ],
	"render": "file:./render.php"
}
